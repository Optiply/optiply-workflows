# Copy to .env for local development (`cp .env.example .env`). Never commit .env.

# api | worker | migrate | all  (all = api + worker in one process, handy for dev)
ROLE=all
# Workflow runs a worker process executes at once (worker and all roles).
WORKER_CONCURRENCY=4
# Let `fetch` in workflow code reach private and loopback addresses (local test servers). Keep false in production.
CODE_FETCH_ALLOW_PRIVATE_NETWORK=false
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# `pnpm dev:db` starts an embedded Postgres on 5433 with these credentials.
DATABASE_URL=postgres://ow:ow@127.0.0.1:5433/optiply_workflows
AUTO_MIGRATE=true

# Where the browser reaches the app (Vite dev server in development).
PUBLIC_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-change-me-change-me-change-me

# Encrypts resource credentials and secret config vars (AES-256-GCM). Comma-separated `<version>:<base64 32 bytes>`;
# new encryptions use ENCRYPTION_KEY_CURRENT (default: the last key). To rotate: append v2, set it current, run rekey.
# Back these up: losing them means losing every stored secret. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=v1:REPLACE_WITH_GENERATED_KEY
# ENCRYPTION_KEY_CURRENT=v1

# Google Workspace SSO. Create an OAuth client (Web application) in Google Cloud Console (consent screen: Internal)
# with redirect URI <PUBLIC_URL>/api/auth/oidc/callback for each URL the app is served at, e.g.
#   http://localhost:5173/api/auth/oidc/callback (Vite) and http://localhost:3000/api/auth/oidc/callback (Compose)
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAIN=optiply.nl

# Break-glass email/password login (users created with `pnpm --filter @ow/server create-admin`).
LOCAL_LOGIN_ENABLED=true

# Workers delete runs that finished more than this many days ago, once a day (0 keeps everything).
# RUN_RETENTION_DAYS=30

# Prometheus /metrics: the API serves it on PORT, workers on METRICS_PORT (default 9464; 0 turns it off).
# Set a token to require `Authorization: Bearer <token>`.
# METRICS_TOKEN=
# METRICS_PORT=9464

# Git sync (M11). Each process keeps a bare cache of the repo here (default <tmp>/ow-git-<pid>; don't share it
# between processes). The repo, token and webhook secret are set by an admin in the app.
# GIT_CACHE_DIR=
# Lets the repo be a file:// or http:// URL (local repos in development and tests). Keep false in production.
# GIT_ALLOW_INSECURE_URLS=false
# Workers check the deploy branch this often, in seconds (0: only the push webhook and Deploy now deploy).
# GIT_POLL_SECONDS=60
# Workers re-check the last deploy's problem objects this often, in minutes (0: only when a resource, config var,
# library query or module changes, and on the next commit).
# GIT_RETRY_MINUTES=10

# Python code blocks (M12) run in the code executor (apps/code-executor, docs/runbooks/python.md). docker compose
# starts it; the app and the executor share this token (without it Python stays off). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PYTHON_EXECUTOR_TOKEN=change-me-change-me-change-me
# Without Docker Compose, point the app at an executor you run (pnpm dev has none: Python blocks then can't run).
# PYTHON_EXECUTOR_URL=http://127.0.0.1:8080
# The executor's limits (its own environment): memory per run in MB, and runs at once.
# PYTHON_MEMORY_MB=256
# PYTHON_MAX_CONCURRENT=4
# Jails started ahead (each used for one run), and the modules they import first (empty for none).
# PYTHON_WARM_JAILS=4
# PYTHON_PREIMPORT=numpy,pandas
# Workflows' own Python packages (M23): the python-builder service installs them; the app and the builder share this
# token (without it, workflows that declare packages can't run or be published). Generate it like the one above.
PYTHON_BUILDER_TOKEN=change-me-change-me-change-me-too
# Where the builder gets wheels (a proxy or mirror of PyPI works too), and its limits.
# PYTHON_PACKAGE_INDEX_URL=https://pypi.org/simple
# PYTHON_ENV_MAX_MB=1024
# PYTHON_ENV_KEEP_DAYS=30

# SSH tunnels through Google Cloud IAP (M18) and Pub/Sub resources (M19) sign in with a service account key kept with
# the resource. To let admins choose this server's own Google identity instead (its Application Default Credentials: the file
# GOOGLE_APPLICATION_CREDENTIALS names, gcloud's application-default login, or the metadata server on Google Cloud):
# GOOGLE_SERVER_IDENTITY=allow
# With Docker Compose on a Mac, docker-compose.gcloud.yml opts in and mounts that gcloud login read-only; keep it for
# every docker compose command with:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gcloud.yml
