{
  "name": "@ow/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --no-node-snapshot --clear-screen=false src/main.ts",
    "start": "node --no-node-snapshot dist/main.js",
    "build": "node build.mjs",
    "migrate": "ROLE=migrate tsx src/main.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "rekey": "tsx src/cli/rekey.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench:webhooks": "WEBHOOK_LATENCY=1 vitest run test/webhook-latency.test.ts --reporter=verbose",
    "verify-secrets": "tsx src/cli/verify-secrets.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@ow/app-definition": "workspace:*",
    "@ow/connectors": "workspace:*",
    "@ow/crypto": "workspace:*",
    "@ow/db": "workspace:*",
    "@ow/definition": "workspace:*",
    "@ow/engine": "workspace:*",
    "@ow/expressions": "workspace:*",
    "@ow/git-format": "workspace:*",
    "@ow/sandbox": "workspace:*",
    "@trpc/server": "11.19.0",
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "busboy": "1.6.0",
    "drizzle-orm": "0.45.4",
    "eslint-scope": "9.1.2",
    "fastify": "5.12.5",
    "isolated-vm": "7.0.1",
    "mysql2": "3.24.5",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "superjson": "2.2.6",
    "undici": "8.11.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ow/code-executor": "workspace:*",
    "@types/busboy": "1.5.4",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
