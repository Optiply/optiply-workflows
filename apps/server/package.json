{
  "name": "@ow/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --no-node-snapshot --clear-screen=false src/main.ts",
    "start": "node --no-node-snapshot dist/main.js",
    "build": "node build.mjs",
    "migrate": "ROLE=migrate tsx src/main.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@ow/crypto": "workspace:*",
    "@ow/db": "workspace:*",
    "@trpc/server": "11.19.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "superjson": "2.2.6",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
