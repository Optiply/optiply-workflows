# HTTPS in front of the app (deploy/docker-compose.prod.yml). SITE_ADDRESS is the public host name: a temporary
# <ip>.sslip.io name, later workflows.optiply.nl. Caddy gets and renews the certificate itself (ports 80 and 443).
{$SITE_ADDRESS} {
	# Compressed: the editor's bundles are large and the free tier's egress is 1 GB a month.
	encode zstd gzip
	reverse_proxy app:3000
}
