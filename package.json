{
  "name": "optiply-workflows",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:db": "pnpm --filter @ow/db dev:db",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @ow/db generate",
    "db:migrate": "pnpm --filter @ow/server migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "turbo": "2.11.7",
    "typescript": "~6.0.3"
  }
}
